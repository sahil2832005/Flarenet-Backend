# Shared with Node.js backend — same PostgreSQL instance
DATABASE_URL=postgres://user:password@localhost:5432/flarenet

# Docker images
VALIDATOR_IMAGE=flarenet/validator:latest
RUNNER_IMAGE=flarenet/runner-base:latest

# S3
S3_BUCKET=flarenet-snapshots
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Signing
MANIFEST_HMAC_SECRET=

# Tuning (optional — defaults shown)
MAX_CONCURRENT_JOBS=3
JOB_TIMEOUT_SECONDS=90
STUCK_JOB_REQUEUE_MINUTES=15
